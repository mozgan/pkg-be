# pkg-be plugin configuration. Copy to pkg-be.conf.
BE_ENABLED = true;
BE_PREFIX = "pkg-be";
# Keep the newest N pkg-be boot environments (0 = keep all).
BE_KEEP = 5;
# Operations that create a BE: upgrade, install, deinstall (delete),
# autoremove, all, none. Comma separated.
BE_HOOKS = "upgrade";
# Also destroy pkg-be BEs older than this (0 = off). The newest is kept.
# Duration: <n>[s|m|h|d|w], e.g. "30d", "2w"; no suffix = seconds.
# BE_KEEP_DAYS = N (old form) still works; BE_KEEP_AGE wins if not 0.
BE_KEEP_AGE = "0";
# Never destroy BEs younger than this, whatever BE_KEEP says (0 = off).
BE_MIN_AGE = "0";
# Create a BE only if a package comes from one of these repositories
# (comma or space separated, as in "pkg -vv"). "local" = packages without
# a repository (pkg add). Empty = any repository.
BE_REPOSITORIES = "";
# Warn when the pool has less than N percent free (0 = off).
BE_MIN_FREE = 10;
# Also log to syslog (facility user). pkg.conf SYSLOG = false turns it off.
BE_SYSLOG = true;
